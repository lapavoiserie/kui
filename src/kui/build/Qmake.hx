package kui.build;

/**
	The qmake half of a payload: the sources, copied, and a `.pri` to include.

	## Why this one gets a rendering of its own

	Every other consumer reads `kui-payload.json` and decides what to do with it.
	qmake cannot: a `.pro` has no JSON parser and no way to run one, and both
	`.pro` files in play collect their sources by **scanning** —
	`$$files(generated/src/*.cpp, true)` under `pui`, a directory walk under
	`qui` — so there is no list to append to from outside either.

	What a `.pro` can do is `include()` another file. So the payload is rendered
	into qmake's own language, once, and the `.pro` includes it:

	```
	exists($$PWD/generated/kui-native.pri): include($$PWD/generated/kui-native.pri)
	```

	guarded by `exists`, because a project with no capabilities produces no file
	and must still build.

	## Why the sources are copied, and not merely named

	This is the one place where an absolute path is the wrong answer, and the
	reason is that **qmake does not run where `kui` did**.

	Both Qt builds compile inside a container: `qui` tars its tree and runs
	`buildrpm` in the Sailfish SDK image, and `pui`'s `packaging/sailfish/build.sh`
	does the same. The tree is mounted at `/source`, and a path like
	`/Users/someone/new-projects/kui/examples/battery/native/battery_sysfs.cpp`
	exists on the host and nowhere else. It would survive being written and be
	missing at the only moment it is read — and a capability that came from a
	haxelib lives outside the tarball no matter what its path says.

	So the sources are copied to `kui-native/<capability>/` beside the generated
	output, and named with `$$PWD`, which qmake resolves against the directory of
	the `.pri` itself. That travels: into the tarball, into the container, onto
	the build machine.

	A directory per capability rather than one flat one, so that two capabilities
	may each ship a `native/util.cpp` without one silently overwriting the other.
**/
class Qmake {
	/**
		Copy what qmake must compile, and write the `.pri` beside it.

		`directory` is where the Haxe output went — `generated/src` for `qui`,
		`generated` for `pui`'s Sailfish packaging. Answers whether anything was
		written, so a caller can say nothing rather than announce an empty step.
	**/
	public static function write(payload:Sidecar, directory:String):Bool {
		var lines = new StringBuf();

		var sources = [];
		var includes = [];
		for (entry in payload.sections("qmake")) {
			var into = "kui-native/" + entry.type.split(".").join("_");
			for (file in strings(entry.section, "files"))
				sources.push(copy(file, directory, into));
			for (include in strings(entry.section, "includes"))
				includes.push(copyTree(include, directory, into));
		}

		var qt = payload.strings("qmake", "qt");
		var pkgconfig = payload.strings("qmake", "pkgconfig");
		var config = payload.strings("qmake", "config");
		var libs = payload.strings("qmake", "libs");

		if (sources.length + includes.length + qt.length + pkgconfig.length
			+ config.length + libs.length == 0) return false;

		lines.add("# Generated by kui. Do not edit: rewritten on every build.\n");
		lines.add("# Declared by " + payload.names().join(", ") + "\n");
		lines.add("#\n# $$PWD, not an absolute path: qmake runs inside a container for\n");
		lines.add("# both Qt backends, where the host's paths do not exist.\n\n");

		add(lines, "SOURCES", sources);
		add(lines, "INCLUDEPATH", includes);
		add(lines, "QT", qt);
		add(lines, "CONFIG", config);
		if (pkgconfig.length > 0) {
			// `link_pkgconfig` is what makes qmake act on PKGCONFIG at all.
			// Added here rather than asked of the capability's author, because
			// PKGCONFIG without it is silently ignored — the worst way for a
			// build setting to be wrong.
			lines.add("CONFIG += link_pkgconfig\n");
			add(lines, "PKGCONFIG", pkgconfig);
		}
		add(lines, "LIBS", libs);

		sys.io.File.saveContent(directory + "/kui-native.pri", lines.toString());
		return true;
	}

	/** Copy one file into the output, and name it the way qmake will read it. **/
	static function copy(from:String, directory:String, into:String):String {
		var name = haxe.io.Path.withoutDirectory(from);
		ensure(directory + "/" + into);
		sys.io.File.copy(from, directory + "/" + into + "/" + name);
		return "$$PWD/" + into + "/" + name;
	}

	/** The same for an include directory, contents and all. **/
	static function copyTree(from:String, directory:String, into:String):String {
		var name = haxe.io.Path.withoutDirectory(haxe.io.Path.removeTrailingSlashes(from));
		var target = directory + "/" + into + "/" + name;
		ensure(target);
		for (entry in sys.FileSystem.readDirectory(from)) {
			var source = from + "/" + entry;
			if (sys.FileSystem.isDirectory(source)) copyTree(source, directory, into + "/" + name);
			else sys.io.File.copy(source, target + "/" + entry);
		}
		return "$$PWD/" + into + "/" + name;
	}

	static function ensure(path:String):Void {
		if (sys.FileSystem.exists(path)) return;
		var parent = haxe.io.Path.directory(path);
		if (parent != "" && parent != path) ensure(parent);
		sys.FileSystem.createDirectory(path);
	}

	static function strings(section:Dynamic, field:String):Array<String> {
		var values:Array<String> = Reflect.field(section, field);
		return values == null ? [] : values;
	}

	static function add(out:StringBuf, variable:String, values:Array<String>):Void {
		if (values.length == 0) return;
		for (value in values) out.add(variable + " += " + value + "\n");
		out.add("\n");
	}
}
